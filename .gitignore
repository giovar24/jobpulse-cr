# --- Seguridad: nunca subir secretos ni datos personales ---
.env
# Datos del usuario separados de los del scraper: perfil, backups, IA del CV
# y los CV importados. La plantilla generica SI se sube:
# data/profile.example.json
data/usuario/
# Compatibilidad con el layout viejo (antes de data/usuario/).
data/profile.json
data/cv_ia.json
data/cv_ia.md
# Credenciales de los portales (usuario/password escritos por el usuario):
# solo viven en esta maquina. Se editan desde la pestaña Credenciales del
# dashboard o con `python credenciales.py --set "Empresa"`.
data/empresas/credenciales.json

# --- Python / dependencias ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Datos generados (regenerables con main.py / cv2profile.py) ---
data/jobs.db
data/jobs.db.bak*
data/jobs.db-*
data/jobpulse.db
data/jobs.backup_*.db
data/embeddings_cache.*
data/report*.csv
data/*_backup_*.json
data/_backup_informes_*/
data/recordatorio_estado.json
data/ui_prefs.json

# --- IA externa: informes y evaluaciones (pueden derivarse del CV real) ---
data/ia_*.csv
data/ia_calibracion.json
data/ia_calibracion.md
data/cv_ia.json
data/cv_ia.md
data/ia_modelo.txt
data/ia_modelos.json
data/ia_proveedor.txt

# --- CVs personales: el CV real del candidato nunca viaja a git ---
# Patrones globales (cualquier carpeta del repo incluida la raiz). El demo
# sintetico (data/demo_cv.docx) ya esta trackeado y no se ve afectado
# por el ignore; cualquier otro PDF/DOC/DOCX quedara local-only.
*.pdf
*.doc
*.docx
!data/demo_cv.docx
# cv2profile tambien acepta .txt/.md: un CV real en texto plano no debe
# viajar a git (el demo publico queda exceptuado).
data/*.txt
data/*.md
!data/demo_cv_en.txt
~$*

# --- Salidas ---
# Entregables: auditorias, reportes de vacantes y calibracion IA. Pueden
# derivarse del CV real, asi que no se versionan. Se redirigen con
# JOBPULSE_INFORMES_DIR si se quieren guardar fuera del proyecto.
informes/
*.log
.streamlit/
# Estado de la corrida en vivo (lo escribe core/progreso.py; volatil, sin datos)
data/corrida_estado.json

# Base local de desarrollo aislado para JobPulse v1.5.
v1_5/data/*.db
v1_5/data/*.db-*
# Datos personales y credenciales del usuario en v1.5 (nunca versionar):
v1_5/data/empresas/
v1_5/data/usuario/
