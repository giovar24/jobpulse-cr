# --- Seguridad: nunca subir secretos ni datos personales ---
.env
# Perfil personal del candidato (contacto, experiencia real...). La plantilla
# generica SI se sube: data/profile.example.json
data/profile.json
# Credenciales de los portales (usuario/password escritos por el usuario):
# solo viven en esta maquina. Se editan desde la pestaña Credenciales del
# dashboard o con `python credenciales.py --set "Empresa"`.
data/empresas/credenciales.json

# --- Python / dependencias ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Datos generados (regenerables con main.py / cv2profile.py) ---
data/jobs.db
data/jobs.backup_*.db
data/embeddings_cache.*
data/report*.csv
data/*_backup_*.json
data/recordatorio_estado.json

# --- IA externa: informes y evaluaciones (pueden derivarse del CV real) ---
data/ia_*.csv
data/ia_calibracion.json
data/ia_calibracion.md
data/cv_ia.json
data/cv_ia.md

# --- CVs personales: el CV real del candidato nunca viaja a git ---
# Patrones globales (cualquier carpeta del repo incluida la raiz). El demo
# sintetico (data/demo_cv.docx) ya esta trackeado y no se ve afectado
# por el ignore; cualquier otro PDF/DOC/DOCX quedara local-only.
*.pdf
*.doc
*.docx
!data/demo_cv.docx
# cv2profile tambien acepta .txt/.md: un CV real en texto plano no debe
# viajar a git (el demo publico queda exceptuado).
data/*.txt
data/*.md
!data/demo_cv_en.txt
~$*

# --- Salidas ---
*.log
.streamlit/
# Estado de la corrida en vivo (lo escribe core/progreso.py; volatil, sin datos)
data/corrida_estado.json
