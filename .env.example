# Credenciales ANE (ane.cr) - OPCIONAL pero recomendado: ANE es el proveedor
# con mas vacantes del sistema. Crea tu cuenta gratuita en https://www.ane.cr
# y pon aqui tu usuario y contrasena; el scraper inicia sesion solo.
# Atajo: si ya iniciaste sesion en ane.cr dentro de Brave, no necesitas nada
# de esto (el scraper reutiliza esa sesion).
# Sin credenciales ni sesion: el barrido ANE se OMITE con un aviso; LinkedIn
# e Indeed siguen funcionando normalmente.
ANE_USER=
ANE_PASSWORD=

# CINDE Jobs: sin credenciales ni navegador (API GraphQL publica de
# cindejobs.com). Opcional: tope de paginas del barrido (cada pagina trae
# hasta 100 vacantes activas).
# CINDE_MAX_PAGES=10

# Rutas de Brave (opcional; defaults de Windows)
# BRAVE_BIN=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
# BRAVE_PERFIL=C:\Users\TU_USUARIO\AppData\Local\BraveSoftware\Brave-Browser\User Data

# Busqueda semantica (core/search_engine.py)
# EmbeddingGemma es gated: agrega tu token de Hugging Face para descargarlo
# (acepta la licencia en https://huggingface.co/google/embeddinggemma-300m).
# HF_TOKEN=
# Modelo de embeddings (opcional; default: google/embeddinggemma-300m).
# Si no definiste HF_TOKEN, se usara automaticamente un fallback multilingue abierto.
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# --- IA externa (OPCIONAL; solo a demanda, nunca en la corrida normal) ---
# Segunda opinion con un LLM fuerte. Sin clave, --ia y --ia-cv avisan y no
# gastan nada.
#
# COMO FUNCIONA: los presets viven en core/ia_api.py (PRESETS) y se activan
# poniendo la clave del proveedor + IA_PROVEEDOR. DESACTIVAR un proveedor =
# comentar su clave (el preset queda para reactivarlo). Todas las claves
# pueden coexistir; la UI permite cambiar de una a otra sin tocar este
# archivo.
#
# Proveedores con preset (elegir UNA linea IA_PROVEEDOR por vez):
#
# NVIDIA NIM (free tier): https://build.nvidia.com
#   IA_PROVEEDOR=nvidia
#   NVIDIA_API_KEY=nvapi-...
#   IA_MODEL=openai/gpt-oss-20b   (los modelos cambian: elegí con
#                                  --ia-listar-modelos o el selector de la UI)
# OpenRouter (cientos de modelos, presupuesto por clave): https://openrouter.ai
#   IA_PROVEEDOR=openrouter
#   OPENROUTER_API_KEY=sk-or-v1-...
#   IA_MODEL=~openai/gpt-latest   (alias "~" = ultimo release; tambien vale
#                                  un slug exacto, ej. openai/gpt-4o-mini.
#                                  VER --ia-listar-modelos)
#   OJO: OpenRouter rechaza (402) requests sin max_tokens; el cliente ya lo
#   fija en 3000.
# Google AI Studio (free tier): https://aistudio.google.com/apikey
#   IA_PROVEEDOR=google
#   IA_API_KEY=tu_clave     (o GEMINI_API_KEY)
# Ollama Cloud (rápido y estable, cuota por tokens): https://ollama.com/keys
#   IA_PROVEEDOR=ollama
#   IA_API_KEY=...          (o OLLAMA_API_KEY)
#   IA_MODEL=gemma4:31b     (rápido, no "piensa"; ideal para CV y lotes)
# OpenAI (de pago): https://platform.openai.com/api-keys
#   IA_PROVEEDOR=openai
#   OPENAI_API_KEY=sk-...
#
# PROVEEDOR MANUAL (cualquier endpoint compatible con OpenAI, sin tocar
# codigo): se usa el preset "custom" con IA_BASE_URL. Sirve para Groq,
# Together, Fireworks, un llama-server local (llama.cpp), LM Studio, vLLM,
# LiteLLM, etc.
#   IA_PROVEEDOR=custom
#   IA_BASE_URL=http://localhost:8080/v1     (ejemplo llama.cpp; en LM Studio
#                                             suele ser http://localhost:1234/v1)
#   IA_API_KEY=local                         (las APIs locales ignoran la clave)
#   IA_MODEL=mi-modelo.gguf
# Un endpoint remoto cualquiera:
#   IA_PROVEEDOR=custom
#   IA_BASE_URL=https://api.groq.com/openai/v1
#   IA_API_KEY=gsk_...
#   IA_MODEL=llama-3.3-70b-versatile
#
# IA_PROVEEDOR=nvidia
# IA_API_KEY=
# IA_MODEL=openai/gpt-oss-20b
# Cuota (free tier): lote de vacantes por request, tope por ejecucion y ritmo.
# IA_LOTE=8
# IA_MAX_VACANTES=60
# IA_MAX_LLAMADAS=12
# IA_RPM=8
# IA_TIMEOUT=120
# Score 0-100 desde el cual la IA considera que una vacante "aplica".
# IA_MIN=70
