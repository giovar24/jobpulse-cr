# Credenciales ANE (ane.cr) - OPCIONAL pero recomendado: ANE es el proveedor
# con mas vacantes del sistema. Crea tu cuenta gratuita en https://www.ane.cr
# y pon aqui tu usuario y contrasena; el scraper inicia sesion solo.
# Atajo: si ya iniciaste sesion en ane.cr dentro de Brave, no necesitas nada
# de esto (el scraper reutiliza esa sesion).
# Sin credenciales ni sesion: el barrido ANE se OMITE con un aviso; LinkedIn
# e Indeed siguen funcionando normalmente.
ANE_USER=
ANE_PASSWORD=

# CINDE Jobs: sin credenciales ni navegador (API GraphQL publica de
# cindejobs.com). Opcional: tope de paginas del barrido (cada pagina trae
# hasta 100 vacantes activas).
# CINDE_MAX_PAGES=10

# Rutas de Brave (opcional; defaults de Windows)
# BRAVE_BIN=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
# BRAVE_PERFIL=C:\Users\TU_USUARIO\AppData\Local\BraveSoftware\Brave-Browser\User Data

# Busqueda semantica (core/search_engine.py)
# EmbeddingGemma es gated: agrega tu token de Hugging Face para descargarlo
# (acepta la licencia en https://huggingface.co/google/embeddinggemma-300m).
# HF_TOKEN=
# Modelo de embeddings (opcional; default: google/embeddinggemma-300m).
# Si no definiste HF_TOKEN, se usara automaticamente un fallback multilingue abierto.
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# --- IA externa (OPCIONAL; solo a demanda, nunca en la corrida normal) ---
# Segunda opinion con un LLM fuerte (Gemini / NVIDIA NIM / OpenAI / cualquier
# endpoint compatible). Sin clave, --ia y --ia-cv avisan y no gastan nada.
#
# Google AI Studio (free tier): https://aistudio.google.com/apikey
#   IA_PROVEEDOR=google
#   IA_API_KEY=tu_clave     (o GEMINI_API_KEY)
# NVIDIA NIM (free tier): https://build.nvidia.com
#   IA_PROVEEDOR=nvidia
#   IA_API_KEY=nvapi-...    (o NVIDIA_API_KEY)
# Cualquier otro endpoint compatible con OpenAI:
#   IA_PROVEEDOR=custom
#   IA_BASE_URL=https://mi-endpoint/v1
#   IA_MODEL=mi-modelo
#
# IA_PROVEEDOR=google
# IA_API_KEY=
# IA_MODEL=gemini-2.5-flash
# Cuota (free tier): lote de vacantes por request, tope por ejecucion y ritmo.
# IA_LOTE=8
# IA_MAX_VACANTES=60
# IA_MAX_LLAMADAS=12
# IA_RPM=8
# IA_TIMEOUT=120
# Score 0-100 desde el cual la IA considera que una vacante "aplica".
# IA_MIN=70
